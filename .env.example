# Generative conversation layer (optional but required for Mom + Bestie chat)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_TIMEOUT_MS=20000

# TypeSafe Jev structured decision layer (optional)
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_TIMEOUT_MS=8000

# Backend
PORT=8787
HOST=0.0.0.0
NODE_ENV=production

# Required when the backend is exposed outside localhost.
# Use a strong random value and configure the same secret in the extension Options page.
APP_SHARED_SECRET=

# Comma-separated origins allowed by CORS. Chrome extension origins may be added after packaging,
# e.g. chrome-extension://abcdefghijklmnop...
ALLOWED_ORIGINS=http://localhost:8787,http://127.0.0.1:8787

# Abuse controls
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=45
REQUEST_BODY_MAX_BYTES=262144

# Optional OpenRouter attribution headers
APP_URL=http://localhost:8787
APP_TITLE=WiseShelf
